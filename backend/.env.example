# ===== AI PROVIDER SELECTION =====
# Opções: gemini, openai, ollama
AI_PROVIDER=gemini

# ===== GEMINI CONFIGURATION =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ===== OPENAI CONFIGURATION =====
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# ===== OLLAMA CONFIGURATION =====
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ===== SERVER CONFIGURATION =====
PORT=3001
NODE_ENV=development

# ===== RATE LIMITING =====
# Tempo em ms para janela de rate limiting
RATE_LIMIT_WINDOW_MS=60000
# Máximo de requisições por janela
RATE_LIMIT_MAX_REQUESTS=10

# ===== VALIDATION =====
# Tamanho máximo de código em bytes (50KB default)
MAX_CODE_SIZE=51200
# Timeout para respostas das IAs em ms
AI_TIMEOUT=30000

# ===== CORS =====
# URLs permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
